//@version=6
indicator("Gann Clean Fan + Levels", shorttitle="Gann Clean", overlay=true, max_lines_count=500, max_labels_count=500)

lookback = input.int(80, "Lookback للـ Pivot", minval=10)
pivotMode = input.string("Last Swing High", options=["Last Swing High", "Last Swing Low"], title="نوع نقطة المرجع")
showLevels = input.bool(true, "إظهار مستويات Gann")
showLabels = input.bool(true, "إظهار التسميات")
extendBars = input.int(250, "طول امتداد الخطوط", minval=50, maxval=500)

show1x1 = input.bool(true, "إظهار 1x1")
show1x2 = input.bool(true, "إظهار 1x2")
show2x1 = input.bool(true, "إظهار 2x1")
show3x1 = input.bool(true, "إظهار 3x1")
show4x1 = input.bool(true, "إظهار 4x1")

highBarsAgo = ta.highestbars(high, lookback)
lowBarsAgo = ta.lowestbars(low, lookback)

pivotBar = pivotMode == "Last Swing High" ? bar_index - highBarsAgo : bar_index - lowBarsAgo
pivotPrice = pivotMode == "Last Swing High" ? high[highBarsAgo] : low[lowBarsAgo]

// ===== دالة رسم زاوية =====
drawAngle(col, rate, direction, labelText) =>
    x1 = pivotBar
    y1 = pivotPrice
    x2 = pivotBar + extendBars
    perBarMove = pivotPrice * 0.00045 * rate
    y2 = y1 + direction * (x2 - x1) * perBarMove
    line.new(x1, y1, x2, y2, xloc=xloc.bar_index, color=col, extend=extend.right, width=1)
    if showLabels
        label.new(x2, y2, text=labelText, xloc=xloc.bar_index, color=color.new(col, 0), textcolor=color.white, style=label.style_label_down, size=size.tiny)

// ===== دالة رسم مستوى سعر =====
drawLevel(levelPrice, col, labelText) =>
    line.new(pivotBar, levelPrice, pivotBar + extendBars, levelPrice, xloc=xloc.bar_index, color=col, extend=extend.right, width=1)
    if showLabels
        label.new(pivotBar + extendBars, levelPrice, text=labelText, xloc=xloc.bar_index, color=color.new(col, 0), textcolor=color.white, style=label.style_none, size=size.tiny)

// ===== نقطة Pivot =====
plotshape(pivotMode == "Last Swing High", title="Pivot High", style=shape.triangleup, location=location.belowbar, color=color.new(color.lime, 0), size=size.small)
plotshape(pivotMode == "Last Swing Low", title="Pivot Low", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.small)

// ===== رسم الزوايا =====
if barstate.islast
    if show1x1
        drawAngle(color.new(color.lime, 0), 1.0, 1, "1x1")
        drawAngle(color.new(color.red, 0), 1.0, -1, "1x1 Down")

    if show1x2
        drawAngle(color.new(color.orange, 0), 0.5, 1, "1x2")
        drawAngle(color.new(color.maroon, 0), 0.5, -1, "1x2 Down")

    if show2x1
        drawAngle(color.new(color.blue, 0), 2.0, 1, "2x1")
        drawAngle(color.new(color.navy, 0), 2.0, -1, "2x1 Down")

    if show3x1
        drawAngle(color.new(color.fuchsia, 0), 3.0, 1, "3x1")
        drawAngle(color.new(color.purple, 0), 3.0, -1, "3x1 Down")

    if show4x1
        drawAngle(color.new(color.teal, 0), 4.0, 1, "4x1")
        drawAngle(color.new(color.gray, 0), 4.0, -1, "4x1 Down")

    // ===== مستويات Gann =====
    if showLevels
        ratios = array.from(0.382, 0.5, 0.618, 1.0, 1.272, 1.618, 2.0, 2.618, 3.0, 3.618, 4.0)
        for i = 0 to array.size(ratios) - 1
            ratio = array.get(ratios, i)
            levelPrice = pivotPrice * ratio
            ratioLabel = str.tostring(ratio, "#.###")
            drawLevel(levelPrice, color.new(color.gray, 0), ratioLabel)
